# Copy to .env (never commit .env) before `docker compose up`.
#
# The password of the shared Postgres database. There is no default: compose stops if it is unset.
# It is placed inside a URL, so use only URL-safe characters (letters, digits, - . _ ~). For example:
#   openssl rand -hex 24
POSTGRES_PASSWORD=replace-me-with-a-long-random-value
