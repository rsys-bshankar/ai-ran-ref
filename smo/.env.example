# Copy to .env (never commit .env) before `docker compose up`.
#
# The database password is not here: scripts/init_secrets.sh writes it to smo/secrets/db_password, which compose
# mounts as a secret (PR-SEC-4.3).

# Optional. Postgres logs every statement slower than this many milliseconds (-1 turns it off, 0 logs all).
# POSTGRES_SLOW_QUERY_MS=500
