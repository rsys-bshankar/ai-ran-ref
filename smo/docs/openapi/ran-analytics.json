  "openapi": "3.1.0",
  "paths": {
    "/health": {
      "get": {
        "description": "Liveness probe. The GUI BFF's GET /modules/status fans out to\n/<module>/health through R1 Termination for every module in parallel,\nso every module answers one \u2014 previously only ran-nf-oam/a1-related\ndid (as their own DME producer-health callback URL).",
        "operationId": "health_check_health_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Health Check"
      }
    },
    "/producers": {
      "get": {
        "description": "OPEN_ITEMS.md section 5: no list/query endpoint for registered\nproducers existed at all \u2014 same gap as list_analytics_subscriptions.",
        "operationId": "list_analytics_producers_producers_get",
        "parameters": [
          {
            "in": "query",
            "name": "analytics_type",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Analytics Type"
            }
          },
          {
            "in": "query",
            "name": "producer_id",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Producer Id"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "List Analytics Producers"
      },
      "post": {
        "description": "RegisterAnalyticsProducer \u2014 an update-in-place upsert on\n(producer_id, analytics_type), not just an insert: the same producer\nre-registering the same analytics_type (e.g. on restart) is a normal\noccurrence, not a conflict, and previously crashed with an unhandled\nIntegrityError on the composite primary key instead. Same shape of\nfix as SME's RegisterService (Foundational Platform LLD section 5).",
        "operationId": "register_analytics_producer_producers_post",
        "parameters": [
          {
            "in": "query",
            "name": "producer_id",
            "required": true,
            "schema": {
              "title": "Producer Id",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "analytics_type",
            "required": true,
            "schema": {
              "title": "Analytics Type",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Body_register_analytics_producer_producers_post"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Register Analytics Producer"
      }
    },
