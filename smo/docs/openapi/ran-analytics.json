    "/producers": {
      "get": {
        "description": "HISTORY.md \u00a75: no list/query endpoint for registered\nproducers existed at all \u2014 same gap as MDAF's own subscriptions list.",
        "operationId": "list_analytics_producers_producers_get",
        "parameters": [
          {
            "in": "query",
            "name": "analytics_type",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Analytics Type"
            }
          },
          {
            "in": "query",
            "name": "producer_id",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Producer Id"
            }
          },
          {
            "description": "Max rows to return (1-500).",
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "default": 100,
              "description": "Max rows to return (1-500).",
              "maximum": 500,
              "minimum": 1,
              "title": "Limit",
              "type": "integer"
            }
          },
          {
            "description": "Rows to skip before the first one returned.",
            "in": "query",
            "name": "offset",
            "required": false,
            "schema": {
              "default": 0,
              "description": "Rows to skip before the first one returned.",
              "minimum": 0,
              "title": "Offset",
              "type": "integer"
            }
          }
        ],
