{
  "components": {
    "schemas": {
      "AdminStateRequest": {
        "properties": {
          "newState": {
            "title": "Newstate",
            "type": "string"
          },
          "requesterId": {
            "title": "Requesterid",
            "type": "string"
          }
        },
        "required": [
          "newState",
          "requesterId"
        ],
        "title": "AdminStateRequest",
        "type": "object"
      },
      "CreateIntentRequest": {
        "properties": {
          "expectations": {
            "items": {
              "additionalProperties": true,
              "type": "object"
            },
            "title": "Expectations",
            "type": "array"
          },
          "intentHandlingScope": {
            "anyOf": [
              {
                "enum": [
                  "RAN",
                  "CN"
                ],
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Intenthandlingscope"
          },
          "intentMgmtPurpose": {
            "default": "FULFILMENT_WITHOUT_NEGOTIATION",
            "enum": [
              "FEASIBILITYCHECK",
              "FEASIBILITYCHECK_WITH_RECOMMENDATIONS",
              "FULFILMENT_WITHOUT_NEGOTIATION",
              "EXPLORATION",
              "FULFILMENT_WITH_NEGOTIATION"
            ],
            "title": "Intentmgmtpurpose",
            "type": "string"
          },
          "priority": {
            "default": 1,
            "title": "Priority",
            "type": "integer"
          },
          "rmihId": {
            "title": "Rmihid",
            "type": "string"
          },
          "rmioId": {
            "default": "",
            "title": "Rmioid",
            "type": "string"
          }
        },
        "required": [
          "expectations",
          "rmihId"
        ],
        "title": "CreateIntentRequest",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "IntentReportRequest": {
        "properties": {
          "conflictReports": {
            "anyOf": [
              {
                "items": {},
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Conflictreports"
          },
          "fulfilmentReport": {
            "additionalProperties": true,
            "title": "Fulfilmentreport",
            "type": "object"
          },
          "intentId": {
            "format": "uuid",
            "title": "Intentid",
            "type": "string"
          }
        },
        "required": [
          "intentId",
          "fulfilmentReport"
        ],
        "title": "IntentReportRequest",
        "type": "object"
      },
      "RegisterRmihRequest": {
        "properties": {
          "capabilities": {
            "items": {
              "additionalProperties": true,
              "type": "object"
            },
            "title": "Capabilities",
            "type": "array"
          },
          "intentHandlingScope": {
            "anyOf": [
              {
                "items": {
                  "enum": [
                    "RAN",
                    "CN"
                  ],
                  "type": "string"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Intenthandlingscope"
          },
          "notificationCallbackUri": {
            "title": "Notificationcallbackuri",
            "type": "string"
          },
          "rmihId": {
            "title": "Rmihid",
            "type": "string"
          },
          "smeServiceId": {
            "title": "Smeserviceid",
            "type": "string"
          }
        },
        "required": [
          "rmihId",
          "smeServiceId",
          "capabilities",
          "notificationCallbackUri"
        ],
        "title": "RegisterRmihRequest",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    },
    "securitySchemes": {
      "r1BearerAuth": {
        "bearerFormat": "JWT",
        "scheme": "bearer",
        "type": "http"
      }
    }
  },
  "info": {
    "title": "Intent Service",
    "version": "1.0.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/health": {
      "get": {
        "description": "Liveness probe. The GUI BFF's GET /modules/status fans out to\n/<module>/health through R1 Termination for every module in parallel,\nso every module answers one \u2014 previously only ran-nf-oam/a1-related\ndid (as their own DME producer-health callback URL).",
        "operationId": "health_check_health_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Health Check"
      }
    },
    "/intent-handling-functions": {
      "get": {
        "description": "List read over registered RMIHs (GUI pass) \u2014 which handlers an\nIntent can actually be dispatched to was otherwise invisible.",
        "operationId": "list_intent_handling_functions_intent_handling_functions_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "List Intent Handling Functions"
      },
      "post": {
        "description": "RegisterIntentHandlingFunction \u2014 rejected if caller is external\n(D-SEC-POLICY-1, unchanged). identity.py's helper distinguishes an\nrApp caller (always rejected here) from a framework-internal SMO\nmodule (SO SMOS / SA SMOS, the only legitimate callers).",
        "operationId": "register_intent_handling_function_intent_handling_functions_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RegisterRmihRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Register Intent Handling Function"
      }
    },
    "/intent-handling-functions/{rmih_id}": {
      "delete": {
        "description": "NEW \u2014 symmetric with Register, closing v1.3's gap (Policy Mgmt LLD section 1).",
        "operationId": "deregister_intent_handling_function_intent_handling_functions__rmih_id__delete",
        "parameters": [
          {
            "in": "path",
            "name": "rmih_id",
            "required": true,
            "schema": {
              "title": "Rmih Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Deregister Intent Handling Function"
      }
    },
    "/intent-reports": {
      "get": {
        "description": "Read side of publish_intent_report \u2014 fulfilment/conflict reports\nwere write-only.",
        "operationId": "list_intent_reports_intent_reports_get",
        "parameters": [
          {
            "in": "query",
            "name": "intent_id",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "format": "uuid",
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Intent Id"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "List Intent Reports"
      },
      "post": {
        "operationId": "publish_intent_report_intent_reports_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/IntentReportRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Publish Intent Report"
      }
    },
    "/intents": {
      "get": {
        "operationId": "query_intents_intents_get",
        "parameters": [
          {
            "in": "query",
            "name": "admin_state",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Admin State"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Query Intents"
      },
      "post": {
        "description": "CreateIntent \u2014 Wave 3 (docs/ownership/INTENT_SERVICE_OWNERSHIP.md's\n\"Open item carried into Wave 3\"): the caller now addresses a specific,\nalready-registered RMIH by `rmihId` (consumer-side selection,\nTS28312_IntentNrm.yaml's own NRM containment \u2014 IntentHandlingFunction\n*contains* Intent), replacing the former producer-side push that\nmatched and notified every capability-matching RMIH after the fact.\n\n404 if `rmihId` names no registered function at all. If the Intent\ndeclares expectation object types and/or a handling scope, the named\nRMIH must actually cover them (`RMIH_CAPABILITY_MISMATCH`, 422) \u2014\naddressing an Intent to a handler that can't fulfil it is rejected at\ncreation, not silently accepted. Dispatch to that one RMIH is\nbest-effort: a callback failure never blocks CreateIntent succeeding.",
        "operationId": "create_intent_intents_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateIntentRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Create Intent"
      }
    },
    "/intents/{intent_id}": {
      "delete": {
        "description": "SPEC_AUDIT.md item 5: no DELETE /intents/{id} existed at all \u2014\nan RMIO had no way to ever retract an Intent it created, only\ndeactivate it (UpdateIntentAdminState). Symmetric with\nderegister_intent_handling_function's own idempotent shape below.",
        "operationId": "delete_intent_intents__intent_id__delete",
        "parameters": [
          {
            "in": "path",
            "name": "intent_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "Intent Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Delete Intent"
      },
      "get": {
        "description": "NEW \u2014 v1.3 had CreateIntent and subscribe/publish, but no read\noperation at all (Policy Mgmt LLD section 1).\n\nWave 3: a real 404 here (rather than crashing) matters more now that\n`Intent.rmih_id`'s ON DELETE CASCADE means an Intent can legitimately\nvanish out from under a caller mid-flight, when its addressed RMIH is\nderegistered.",
        "operationId": "query_intent_intents__intent_id__get",
        "parameters": [
          {
            "in": "path",
            "name": "intent_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "Intent Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Query Intent"
      }
    },
    "/intents/{intent_id}/admin-state": {
      "patch": {
        "description": "NEW \u2014 closes v1.3's gap: intentAdminState had two enum values and no\noperation ever transitioning it. RMIO-only, checked against rmioId.",
        "operationId": "update_intent_admin_state_intents__intent_id__admin_state_patch",
        "parameters": [
          {
            "in": "path",
            "name": "intent_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "Intent Id",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AdminStateRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Update Intent Admin State"
      }
    }
  },
  "security": [
    {
      "r1BearerAuth": []
    }
  ]
}
