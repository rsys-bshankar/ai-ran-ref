    "/orders/{order_id}/cancel": {
      "post": {
        "description": "Reassigns order.steps to a NEW list rather than mutating the\nexisting one's dicts in place \u2014 a plain JSON column's list is never\ntracked by SQLAlchemy's change detection on in-place mutation\n(that needs sqlalchemy.ext.mutable), so the old in-place version of\nthis route silently never persisted the CANCELLED status at all:\ncommit()'s default expire-on-commit re-fetched the unchanged row\nright back, discarding the edit.",
        "operationId": "cancel_order_orders__order_id__cancel_post",
        "parameters": [
          {
            "in": "path",
            "name": "order_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "Order Id",
              "type": "string"
