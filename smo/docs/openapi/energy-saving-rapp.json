            "default": 24,
            "title": "Hours",
            "type": "number"
          },
          "managedElementRef": {
            "title": "Managedelementref",
            "type": "string"
          },
          "start": {
            "format": "date-time",
            "title": "Start",
            "type": "string"
          },
          "stepMinutes": {
            "default": 60,
            "title": "Stepminutes",
            "type": "integer"
          }
        },
        "required": [
          "managedElementRef",
          "cells",
          "start"
        ],
        "title": "SimPublishRequest",
        "type": "object"
      },
