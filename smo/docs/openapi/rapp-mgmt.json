    "/instances/{instance_id}/recover": {
      "post": {
        "description": "RECOVER \u2014 v1.3's own FAULTED exit, concretized: the FSM transition\n(FAULTED -> DEPLOYING) existed but no route ever fired it, so a\ncritically-faulted instance had no API path back to RUNNING at all.\nRe-enters at the same point CreateInstance does \u2014 the container must\nre-bootstrap and call bootstrap-complete again, matching the \"no\nlightweight update path\" principle this build applies everywhere\nelse (e.g. AI/ML Workflow's retraining re-entry).",
        "operationId": "recover_instance_instances__instance_id__recover_post",
        "parameters": [
          {
            "in": "path",
            "name": "instance_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "Instance Id",
              "type": "string"
            }
