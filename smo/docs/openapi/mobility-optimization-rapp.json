            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "SimPublishRequest": {
        "properties": {
          "hours": {
            "default": 24,
            "title": "Hours",
            "type": "integer"
          },
          "managedElementRef": {
            "title": "Managedelementref",
            "type": "string"
          },
          "relations": {
            "additionalProperties": {
              "type": "string"
            },
            "title": "Relations",
            "type": "object"
          },
          "start": {
            "format": "date-time",
            "title": "Start",
            "type": "string"
          }
        },
        "required": [
          "managedElementRef",
          "relations",
          "start"
        ],
        "title": "SimPublishRequest",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
