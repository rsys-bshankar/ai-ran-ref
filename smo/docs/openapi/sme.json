  "paths": {
    "/capif-events/v1/{subscriber_id}/subscriptions": {
      "post": {
        "description": "OPEN_ITEMS.md section 5: event subscription filtering was type-only\n\u2014 the reference's own CAPIFEventFilter also filters by apiId/\napiInvokerId/aefId (eventservice.go's getMatchingSubs). Of those,\nonly apiId is meaningfully implementable here: apiInvokerId filters\nagainst an event's own ApiInvokerIds, which only API_INVOKER_ONBOARDED\nevents carry \u2014 a real CAPIF Invoker-onboarding subsystem this build\ndoesn't have (see this module's own structurally-out-of-scope note);\nour SERVICE_API_* notifications have no invoker id in their payload\nto filter on. aefId likewise needs aefProfiles, which ServiceProfile\ndoesn't model (the separate \"flattened ServiceProfile\" gap). apiId\nmaps directly onto this build's own service_id, so that one's real.",
        "operationId": "subscribe_events_capif_events_v1__subscriber_id__subscriptions_post",
        "parameters": [
          {
            "in": "path",
            "name": "subscriber_id",
            "required": true,
            "schema": {
              "title": "Subscriber Id",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/EventSubscriptionRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Subscribe Events"
      }
    },
    "/capif-events/v1/{subscriber_id}/subscriptions/{subscription_id}": {
      "delete": {
        "operationId": "unsubscribe_events_capif_events_v1__subscriber_id__subscriptions__subscription_id__delete",
        "parameters": [
          {
            "in": "path",
            "name": "subscriber_id",
            "required": true,
            "schema": {
              "title": "Subscriber Id",
              "type": "string"
            }
          },
          {
            "in": "path",
            "name": "subscription_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "Subscription Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Unsubscribe Events"
      }
    },
    "/provider-registrations": {
      "post": {
        "description": "OPEN_ITEMS.md section 5: Provider (APF) enrolment\n(`PostRegistrations`, `providermanagement.go`) \u2014 the real registry\n`register_service`'s own `apf_id` check needs, entirely absent\nbefore this pass. Idempotent update-in-place on a re-registration of\nthe same `apfId`, the same shape `register_service`'s own\nsame-producer re-registration already uses \u2014 the reference's real\ndomain/function-id collision detection doesn't apply here, since\nthis build has no separate provider-domain concept to collide on.",
        "operationId": "register_provider_provider_registrations_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ProviderRegistrationRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Register Provider"
      }
    },
    "/provider-registrations/{apf_id}": {
      "delete": {
        "description": "DeleteRegistrationsRegistrationId, providermanagement.go \u2014 idempotent,\nmatching the reference's own delete-if-present-else-still-204 shape.",
        "operationId": "deregister_provider_provider_registrations__apf_id__delete",
        "parameters": [
          {
            "in": "path",
            "name": "apf_id",
            "required": true,
            "schema": {
              "title": "Apf Id",
              "type": "string"
            }
