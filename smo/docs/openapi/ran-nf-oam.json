      }
    },
    "/dme-jobs": {
      "post": {
        "description": "DME's own job-push callback (OPEN_ITEMS.md section 5): DME's\ncreate_data_job now actually POSTs the job to jobCallbackUrl on\ncreate \u2014 subscribe_pm registers this exact URL, so this closes the\nsame class of dangling-callback bug the /health route closed for\nthe health-supervision URL. Phase 1: acks only, no real per-job\nstate tracked producer-side.",
        "operationId": "receive_dme_job_dme_jobs_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "additionalProperties": true,
                "title": "Body",
                "type": "object"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Receive Dme Job"
      }
    },
