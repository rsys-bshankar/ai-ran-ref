  "info": {
    "title": "RAN NF OAM SMOS",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/alarms": {
      "get": {
        "operationId": "query_alarms_alarms_get",
        "parameters": [
          {
            "in": "query",
            "name": "managed_element_ref",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Managed Element Ref"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Query Alarms"
      }
    },
    "/alarms/ingest": {
      "post": {
        "description": "alarmId is ALWAYS a fresh UUID minted here, never the raising ME's\nnative ID \u2014 RAN NF OAM LLD section 3.3, closing R1UCR's own flagged,\nunresolved collision risk under a fleet of N MEs.\n\nprobableCause/specificProblem/rootCauseIndicator/correlatedNotifications/\nproposedRepairActions (OPEN_ITEMS.md section 5): the standard fault\nfields 3GPP TS 28.532 FaultMnS's NotifyNewAlarm carries, previously\nentirely absent from this alarm model. alarmType (SPEC_AUDIT.md,\nTS28111_FaultNrm.yaml's AlarmRecord) was the one of these fields\nstill missing after that pass.",
        "operationId": "ingest_alarm_alarms_ingest_post",
        "parameters": [
          {
            "in": "query",
            "name": "source_alarm_id",
            "required": true,
            "schema": {
              "title": "Source Alarm Id",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "managed_element_ref",
            "required": true,
            "schema": {
              "title": "Managed Element Ref",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "severity",
            "required": true,
            "schema": {
              "title": "Severity",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "correlation_group",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Correlation Group"
            }
          },
          {
            "in": "query",
            "name": "probable_cause",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Probable Cause"
            }
          },
          {
            "in": "query",
            "name": "specific_problem",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Specific Problem"
            }
          },
          {
            "in": "query",
            "name": "root_cause_indicator",
            "required": false,
            "schema": {
              "default": false,
              "title": "Root Cause Indicator",
              "type": "boolean"
            }
          },
          {
            "in": "query",
            "name": "correlated_notifications",
            "required": false,
            "schema": {
              "default": [],
              "items": {
                "format": "uuid",
                "type": "string"
              },
              "title": "Correlated Notifications",
              "type": "array"
            }
          },
          {
            "in": "query",
            "name": "proposed_repair_actions",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Proposed Repair Actions"
            }
          },
          {
            "in": "query",
            "name": "alarm_type",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Alarm Type"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Ingest Alarm"
      }
    },
    "/alarms/{alarm_id}/ack": {
      "patch": {
        "description": "ackUserId (SPEC_AUDIT.md, TS28111_FaultNrm.yaml's AlarmRecord) \u2014\nwho acknowledged it, never recorded before. alarmChangedTime (the\nspec's own \"last mutated\" timestamp, distinct from raised_at/\ncleared_at) updates here and in clear_alarm below, the two places\nthis build actually mutates an existing alarm.",
        "operationId": "change_alarm_ack_state_alarms__alarm_id__ack_patch",
        "parameters": [
          {
            "in": "path",
            "name": "alarm_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "Alarm Id",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "new_state",
            "required": true,
            "schema": {
              "title": "New State",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "ack_user_id",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Ack User Id"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Change Alarm Ack State"
      }
    },
    "/alarms/{alarm_id}/clear": {
      "patch": {
        "description": "OPEN_ITEMS.md section 5: no alarm-cleared lifecycle existed at\nall \u2014 `/alarms/{id}/ack` only ever toggled ack_state, so an alarm\nthat stopped recurring on the NF had no way to ever be marked\nresolved. Matches the reference's own NotifyClearedAlarm shape:\nsetting severity to 'cleared' (already a valid value in this\nbuild's own CHECK constraint) rather than a separate state field.",
        "operationId": "clear_alarm_alarms__alarm_id__clear_patch",
        "parameters": [
          {
            "in": "path",
            "name": "alarm_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "Alarm Id",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "clear_user_id",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Clear User Id"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Clear Alarm"
      }
    },
    "/config-jobs": {
      "post": {
        "description": "WriteConfigurationChanges \u2014 RAN NF OAM LLD section 5.1's full\nsequence: MSAC gate, schema check (cache-or-fetch), decompose into\nsub_changes, PATCH each independently, aggregate.",
        "operationId": "write_configuration_changes_config_jobs_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/WriteConfigRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "202": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
