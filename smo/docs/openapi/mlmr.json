          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Download Model Artifact"
      }
    },
    "/models/{model_id}/lifecycle": {
      "patch": {
        "description": "Wave 1's minimal necessary cross-service plumbing: AIMgF owns the\ndecision of what `state`/`trainingJobId` a model moves to (its own\nFSM, per docs/ownership/AIMGF_OWNERSHIP.md) and MLLF owns\n`clearedNodeGroups` (docs/ownership/MLLF_OWNERSHIP.md) \u2014 but only MLMR\ncan write its own row. Not a generic PATCH: only these three fields,\nmatching exactly what used to be direct ORM writes from the same\nprocess before this split, no new business logic.",
        "operationId": "update_model_lifecycle_models__model_id__lifecycle_patch",
        "parameters": [
          {
            "in": "path",
            "name": "model_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "Model Id",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateLifecycleRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Update Model Lifecycle"
      }
    }
  }
