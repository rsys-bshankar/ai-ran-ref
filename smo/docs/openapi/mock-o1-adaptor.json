{
  "components": {
    "schemas": {
      "FaultBody": {
        "properties": {
          "count": {
            "default": 1,
            "title": "Count",
            "type": "integer"
          },
          "managedObjectRef": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Managedobjectref"
          },
          "mode": {
            "title": "Mode",
            "type": "string"
          }
        },
        "required": [
          "mode"
        ],
        "title": "FaultBody",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
  "info": {
    "title": "Mock O1 Adaptor (NETCONF test double)",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/capabilities": {
      "get": {
        "description": "The vendor capability declaration RAN NF OAM's vendor onboarding\nflow discovers (Wave 9 W9-03, `POST /ran-nf-oam/vendor-onboarding`\nwith `discoverFrom`, read at this fixed path on the adaptor's registered\norigin): which vendor this adaptor fronts, which MnS\nservices it implements and which O1 transports it speaks. Configurable\nper deployment so one image can stand in for several vendors.",
        "operationId": "declare_capabilities_capabilities_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Declare Capabilities"
      }
    },
    "/edit-config": {
      "post": {
        "description": "Mirrors netconf_client.py's own build_edit_config_rpc/send_edit_config\nexactly: parses the real <rpc><edit-config>...</edit-config></rpc>\nrequest, replies <rpc-reply><ok/></rpc-reply> (RFC 6241 section 4.2) on\nsuccess. REJECTED (a real <rpc-error>, same as a real NETCONF agent\nrefusing a request) when the managed-object ref is missing, or its\nconfig body is empty for any operation other than delete/remove \u2014 a\ndelete legitimately carries no attribute_changes at all (RFC 6241\nsection 7.2's `operation` attribute), so rejecting it for emptiness\nwould be wrong. Non-delete/remove emptiness rejection is the same\n\"empty payload is a real, testable rejection trigger\" pattern\nmock-near-rt-ric's own create_policy already established for an\nempty policyObject.",
        "operationId": "edit_config_edit_config_post",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Edit Config"
      }
    },
    "/edit-config/{managed_object_ref}": {
      "get": {
        "description": "Not part of the real NETCONF RPC surface \u2014 a test-only introspection\nroute (matching this build's own `_policies`-dict-backed test doubles\nelsewhere) so a real integration test can assert what was actually\napplied, not just that the call returned 200.",
        "operationId": "query_last_applied_edit_config__managed_object_ref__get",
        "parameters": [
          {
            "in": "path",
            "name": "managed_object_ref",
            "required": true,
            "schema": {
              "title": "Managed Object Ref",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Query Last Applied"
      }
    },
    "/faults": {
      "post": {
        "description": "Test-only (like GET /edit-config/{ref}): make the next `count`\nmatching edit-configs misbehave, so the SMO's retry, verification and\nrollback paths can be exercised against a real round trip.",
        "operationId": "inject_fault_faults_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/FaultBody"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Inject Fault"
      }
    },
    "/objects/{managed_object_ref}": {
      "get": {
        "description": "Test-only introspection of one managed function's running config.",
        "operationId": "query_object_objects__managed_object_ref__get",
        "parameters": [
          {
            "in": "path",
            "name": "managed_object_ref",
            "required": true,
            "schema": {
              "title": "Managed Object Ref",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "function_ref",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Function Ref"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Query Object"
      }
    },
    "/state": {
      "delete": {
        "description": "Test-only: forget every applied change and pending fault.",
        "operationId": "reset_state_state_delete",
        "responses": {
          "204": {
            "description": "Successful Response"
          }
        },
        "summary": "Reset State"
      }
    }
  }
}
