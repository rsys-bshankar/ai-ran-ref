  "info": {
    "title": "Mock O1 Adaptor (NETCONF test double)",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/edit-config": {
      "post": {
        "description": "Mirrors netconf_client.py's own build_edit_config_rpc/send_edit_config\nexactly: parses the real <rpc><edit-config>...</edit-config></rpc>\nrequest, replies <rpc-reply><ok/></rpc-reply> (RFC 6241 section 4.2) on\nsuccess. REJECTED (a real <rpc-error>, same as a real NETCONF agent\nrefusing a request) when the managed-object ref is missing or its\nconfig body is empty \u2014 the same \"empty payload is a real, testable\nrejection trigger\" pattern mock-near-rt-ric's own create_policy\nalready established for an empty policyObject.",
        "operationId": "edit_config_edit_config_post",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Edit Config"
      }
    },
    "/edit-config/{managed_object_ref}": {
      "get": {
        "description": "Not part of the real NETCONF RPC surface \u2014 a test-only introspection\nroute (matching this build's own `_policies`-dict-backed test doubles\nelsewhere) so a real integration test can assert what was actually\napplied, not just that the call returned 200.",
        "operationId": "query_last_applied_edit_config__managed_object_ref__get",
        "parameters": [
          {
            "in": "path",
            "name": "managed_object_ref",
            "required": true,
            "schema": {
              "title": "Managed Object Ref",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Query Last Applied"
      }
    }
  }
}
