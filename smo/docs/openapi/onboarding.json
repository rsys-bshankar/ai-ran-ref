    "/packages/{package_id}/deprime": {
      "post": {
        "description": "The reference's own deprimeRapp guard: blocked while any rApp\ninstance still references this package (mirrors the cascade-delete\nguard's active-usage-registration check): 409 SERVICE_NAME_CONFLICT.\nAny state but PRIMED: 409 LIFECYCLE_ILLEGAL_TRANSITION.",
        "operationId": "deprime_package_packages__package_id__deprime_post",
        "parameters": [
          {
            "in": "path",
            "name": "package_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "Package Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Deprime Package"
      }
    },
    "/packages/{package_id}/onboarding-status": {
      "get": {
        "description": "404 PACKAGE_NOT_FOUND for an unknown package.",
