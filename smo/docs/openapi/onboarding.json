              "type": "integer"
            }
          },
          {
            "description": "Rows to skip before the first one returned.",
            "in": "query",
            "name": "offset",
            "required": false,
            "schema": {
              "default": 0,
              "description": "Rows to skip before the first one returned.",
              "minimum": 0,
              "title": "Offset",
