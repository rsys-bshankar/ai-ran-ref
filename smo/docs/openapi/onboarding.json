                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Query Onboarding Status"
      }
    },
    "/packages/{package_id}/prime": {
      "post": {
        "description": "HISTORY.md \u00a75: the reference's real\nCOMMISSIONED->PRIMING->PRIMED lifecycle, missing entirely \u2014 this\nbuild went ONBOARDING->AVAILABLE directly. Real ACM/DME/SME\nresource pre-provisioning behind priming is out of scope (same\nelision as this build's other southbound calls), so both\ntransitions fire within this one request. 409\nLIFECYCLE_ILLEGAL_TRANSITION from any state but AVAILABLE.",
        "operationId": "prime_package_packages__package_id__prime_post",
        "parameters": [
          {
            "in": "path",
            "name": "package_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "Package Id",
