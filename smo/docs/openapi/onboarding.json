      "get": {
        "description": "(GUI pass 2) Usage registrations behind the cascade-delete guard (call flow 06):\nany row still missing stoppedAt blocks deprime and delete, so the operator\ncan now see why a delete was refused.",
        "operationId": "list_package_usage_packages__package_id__usage_get",
        "parameters": [
          {
            "in": "path",
            "name": "package_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "Package Id",
              "type": "string"
            }
          },
          {
            "description": "Max rows to return (1-500).",
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "default": 100,
              "description": "Max rows to return (1-500).",
              "maximum": 500,
              "minimum": 1,
