      "get": {
        "description": "(GUI pass 2) The artifacts registered during validation (Onboarding LLD section 1).",
        "operationId": "list_package_artifacts_packages__package_id__artifacts_get",
        "parameters": [
          {
            "in": "path",
            "name": "package_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "Package Id",
              "type": "string"
