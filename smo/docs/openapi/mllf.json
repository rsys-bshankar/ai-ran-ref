            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Health Check"
      }
    },
    "/models/{model_id}/deploy": {
      "post": {
        "description": "RequestModelDeployment. Requires CERTIFIED-or-later state (the\nAIMgF gate, unchanged from v1.3, now read cross-service from MLMR)\nand stamps clearedNodeGroups (LLD section 5, MultiNode Q2's\ntargeting gap) back onto MLMR's own row \u2014 see\n`PATCH /models/{id}/lifecycle` in mlmr/app/main.py.",
        "operationId": "request_model_deployment_models__model_id__deploy_post",
        "parameters": [
          {
            "in": "path",
            "name": "model_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "Model Id",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "items": {
                  "type": "string"
                },
                "title": "Node Groups",
