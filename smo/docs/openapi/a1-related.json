    "/health": {
      "get": {
        "description": "Producer health-supervision callback (OPEN_ITEMS.md section 5):\nregister_ei_type registers this exact URL with DME as its\nproducerHealthCallbackUrl, but no route ever answered it \u2014 a health\npoller hitting the registered callback would 404 against a producer\nthis module itself just told DME was healthy. A plain liveness\ncheck: reachable and 200 means this A1 Related instance is up.",
        "operationId": "health_check_health_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
