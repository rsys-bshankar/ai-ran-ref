                }
              ],
              "title": "Near Rt Ric Id"
            }
          },
          {
            "in": "query",
            "name": "creator_id",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Creator Id"
            }
          }
        ],
        "responses": {
