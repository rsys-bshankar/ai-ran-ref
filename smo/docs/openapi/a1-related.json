    "/services/{service_id}/keepalive": {
      "put": {
        "description": "keepAliveService, pms-api-v3.json \u2014 the heartbeat a registered\nservice invokes regularly to reset its own supervision clock; a\nservice that never calls this (or re-registers via PUT /services)\nwithin its own keepAliveIntervalSeconds is swept the next time\nGET /services reads it (see _sweep_stale_service).",
        "operationId": "keepalive_service_services__service_id__keepalive_put",
