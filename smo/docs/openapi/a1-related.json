    "/policies": {
      "get": {
        "description": "OPEN_ITEMS.md section 5: no policy list/query-by-filter endpoint\nexisted at all \u2014 only GET /policies/{id}, despite the mapping-store's\nwhole job (section 1.1) being to track these mappings. Filterable by\npolicyTypeId/nearRtRicId/creatorId (the \"type/RIC/service\" filters\nthe gap named \u2014 creatorId is the closest concept this model has to\n\"service\", since it's the rApp/service that created the policy).",
        "operationId": "query_policies_policies_get",
        "parameters": [
          {
            "in": "query",
            "name": "policy_type_id",
            "required": false,
            "schema": {
