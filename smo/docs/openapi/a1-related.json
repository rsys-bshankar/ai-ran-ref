              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Query Policies"
      },
      "post": {
        "description": "Create A1 policy \u2014 section 1.1's confirmed thin-envelope sequence:\nAuthZ (via SME, elided in this reference), generate policyId, the\nA1UCR clause 6.3 call to the Near-RT RIC (a1_termination_client, the\nmock endpoint per SMO Design v1.3 section 3.9, closes RT-7), then\nstore the policyId<->nearRtRicId mapping AND the resulting\nenforcement status. The mapping-store role is still the actual\nin-scope substance \u2014 the southbound call is a real dependency now,\nnot silently elided.",
        "operationId": "create_policy_policies_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreatePolicyRequest"
