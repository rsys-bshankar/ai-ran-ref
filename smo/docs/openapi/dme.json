    "/data-jobs/{data_job_id}": {
      "delete": {
        "description": "Handles both directions per section 3.7: a Consumer rApp cancelling\nits own job, or the DME framework itself tearing down a job it created\nagainst a Producer rApp (consumer_id == 'DME_FRAMEWORK').",
